# ============================================================
#  Настройки Web Inspiration Analyzer
#  Скопируйте этот файл в .env (start.bat делает это сам)
#  и впишите нужные значения. Файл .env НЕ публикуйте.
# ============================================================

# --- Сервер ------------------------------------------------
# Порт API. Интерфейс в режиме разработки: http://127.0.0.1:5173
PORT=8787
# По умолчанию сервер слушает только этот компьютер.
# Не меняйте на 0.0.0.0, пока не задан ADMIN_TOKEN.
HOST=127.0.0.1
# Пароль для панели, если сервер доступен не только вам (латиница и цифры).
ADMIN_TOKEN=

# --- Поиск референсов (режим B) ------------------------------
# Нужен ОДИН из вариантов. Без ключей автоматический поиск выключен,
# останется ручное добавление URL.
#
# Вариант 1: Brave Search API  https://brave.com/search/api/
BRAVE_API_KEY=
# Вариант 2: Google Programmable Search  https://programmablesearchengine.google.com/
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# --- ИИ-анализ (необязательно) -------------------------------
# Если указать ключ, на странице «Добавить URL» появится
# галочка «Дополнить анализ с помощью ИИ».
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- Ограничения при обращении к чужим сайтам ----------------
# Минимальная пауза между запросами к одному сайту, мс
FETCH_MIN_INTERVAL_MS=2000
# Тайм-аут одного запроса, мс
FETCH_TIMEOUT_MS=10000
# Как долго хранить скачанную страницу в кэше, часов
CACHE_TTL_HOURS=6
# Максимум страниц, которые анализатор загрузит за один запуск
MAX_PAGES_PER_ANALYSIS=4

# --- Заявки с сайта (необязательно) --------------------------
# Пока пусто — сайт работает в демонстрационном режиме
# и заявки никуда не уходят.
BOOKING_TELEGRAM_BOT_TOKEN=
BOOKING_TELEGRAM_CHAT_ID=

# --- Сайт (клиентская часть) ---------------------------------
# Адрес, на который форма записи отправляет заявку.
# Пусто = демонстрационный режим: форма проверяет поля, но ничего не отправляет.
# Чтобы заявки шли на ваш сервер (и дальше в Telegram), впишите: /api/bookings
# Внимание: сюда НЕ вписывайте секретные ключи — переменные VITE_* попадают в браузер.
VITE_BOOKING_ENDPOINT=
